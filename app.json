    {
      "id": "sense_monitor",
      "name": {
        "en": "Sense Monitor"
      },
      "class": "sensor",
      "capabilities": [
        "measure_power",
        "meter_power",
        "measure_power.solar",
        "measure_power.grid",
        "measure_power.net"
      ],
      "images": {
        "small": "/drivers/sense_monitor/assets/images/small.png",
        "large": "/drivers/sense_monitor/assets/images/large.png"
      }
    }
  ]
}
