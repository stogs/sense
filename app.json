{
  "id": "com.sense.energy",
  "version": "1.0.0",
  "compatibility": ">=12.0.0",
  "name": {
    "en": "Sense Energy"
  },
  "description": {
    "en": "Monitor your home energy usage, solar production, and real-time power with Sense."
  },
  "category": [
    "energy"
  ],
  "permissions": [],
