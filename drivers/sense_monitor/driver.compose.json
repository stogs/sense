{
  "name": {
    "en": "Sense Monitor"
  },
  "class": "sensor",
  "platforms": [
    "local"
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Sense Credentials"
      },
      "children": [
        {
          "id": "username",
          "type": "text",
          "label": {
            "en": "Email / Username"
          },
          "hint": {
            "en": "Your Sense account email address"
          }
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password"
          },
          "hint": {
            "en": "Your Sense account password"
          }
        }
      ]
    }
  ],
  "connectivity": [
    "cloud"
  ],
  "capabilities": [
    "measure_power",
    "meter_power"
  ],
  "pair": [
    {
      "id": "add_device"
    }
  ],
  "images": {
    "small": "/drivers/sense_monitor/assets/images/small.png",
    "large": "/drivers/sense_monitor/assets/images/large.png"
  }
}