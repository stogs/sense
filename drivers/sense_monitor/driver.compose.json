{
  "name": {
    "en": "Sense Monitor"
  },
  "class": "sensor",
  "platforms": [
    "local"
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Sense Credentials"
      },
      "children": [
        {
          "id": "username",
          "type": "text",
          "label": {
            "en": "Email / Username"
          },
          "hint": {
            "en": "Your Sense account email address"
          }
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password"
          },
          "hint": {
            "en": "Your Sense account password"
          }
        }
      ]
    }
