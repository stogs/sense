{
  "name": {
    "en": "Sense Monitor"
  },
  "class": "sensor",
  "platforms": [
    "local"
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Sense Credentials"
      },
      "children": [
        {
          "id": "username",
          "type": "text",
          "label": {
            "en": "Email / Username"
          },
          "hint": {
            "en": "Your Sense account email address"
          }
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password"
          },
          "hint": {
            "en": "Your Sense account password"
          }
        }
      ]
    }
  ],
  "connectivity": [
    "cloud"
  ],
  "capabilities": [
    "measure_power",
    "meter_power",
    "measure_power.solar",
    "measure_power.grid",
    "measure_power.net"
  ],
  "capabilitiesOptions": {
    "measure_power.solar": {
      "title": {
        "en": "Solar"
      }
    },
    "measure_power.grid": {
      "title": {
        "en": "Grid"
      }
    },
    "measure_power.net": {
      "title": {
        "en": "Net"
      }
    }
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "title": {
          "en": "Sense Login"
        },
        "usernameLabel": {
          "en": "Email / Username"
        },
        "usernamePlaceholder": {
          "en": "name@example.com"
        },
        "passwordLabel": {
          "en": "Password"
        },
        "passwordPlaceholder": {
          "en": "••••••••"
        }
      },
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      },
      "options": {
        "singular": false
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "images": {
    "small": "/drivers/sense_monitor/assets/images/small.png",
    "large": "/drivers/sense_monitor/assets/images/large.png"
  }
}